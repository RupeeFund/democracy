# Holds the private info on people/groups
uid0::
  email: "me@example.com"
  phone: "1234567890"
  languages:: "english", "hindi", "ladakhi"
  upi: "id@okicici.com"
  pan_number: "ABCDE1234E"
  address: """
  your-favourite-longest-address,
  without restrictions,
  in typical indian style,
  with or without hierarchy,
  but don't get this wrong,
  and always include
  PINCODE
  """

gid0::
  email: "me@example.com"
  phone: "1234567890"
  languages:: "english", "tamil"
  pan_number: "ABCDE1234E"
  address: """
  your-favourite-longest-address,
  without restrictions,
  in typical indian style,
  with or without hierarchy,
  but don't get this wrong,
  and always include
  PINCODE
  """
  bank_account::
    name: "XYZ Department"
    type: "savings"
    ifsc: "BANK0123456"

